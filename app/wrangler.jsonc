{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoposter",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autoposter",
      "database_id": "de304c9e-62ce-427b-bec7-f4f742da8dde",
      "migrations_dir": "migrations"
    }
  ],
  // no R2: videos stay on the PC (pc-worker/poster.py uploads them at posting time)
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "TIMEZONE": "Europe/Paris", "PUBLIC_URL": "https://autoposter.fivestars6.workers.dev" }
}
