{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoposter",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // keep variables added in the Cloudflare dashboard when deploying from here
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autoposter",
      "database_id": "de304c9e-62ce-427b-bec7-f4f742da8dde",
      "migrations_dir": "migrations"
    }
  ],
  // no R2: videos stay on the PC (pc-worker/poster.py uploads them at posting time)
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "TIMEZONE": "Europe/Paris", "PUBLIC_URL": "https://autoposter.fivestars6.workers.dev",
    // Meta app "Autoposter" + its Instagram login configuration (the app secret is a Cloudflare secret)
    "IG_APP_ID": "1765237335172412",
    "IG_CONFIG_ID": "2056529495049245",
    "IG_USER_ID": "17841475127975476",
    // Google OAuth client for YouTube (the client secret is a Cloudflare secret)
    "YT_CLIENT_ID": "826705965869-qe11g1eobat4nvh4sf6c7kgbornldkgd.apps.googleusercontent.com",
    "TT_CLIENT_KEY": "sbawism3upfkul8xz3"
  }
}
